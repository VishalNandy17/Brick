# ============================================
# BRICK IAM - Production Enterprise Configuration
# ============================================

# Server Configuration
SERVER_PORT=8080
NODE_ENV=production

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GATEWAY_TIMEOUT=30000

# Fabric Gateway Configuration
FABRIC_CONNECTION_PROFILE=./connection.json
FABRIC_GATEWAY_TIMEOUT=30000

# Fabric Network Configuration
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=brick-identity

# Organization Configuration
FABRIC_ORG_NAME=Org1
FABRIC_ORG_MSPID=Org1MSP

# Peer Configuration
FABRIC_PEER_HOST=localhost
FABRIC_PEER_PORT=7051
FABRIC_PEER_TLS_ENABLED=true

# Certificate and Key Paths
FABRIC_TLS_CERT_PATH=./certs/peer0.org1.example.com-cert.pem
FABRIC_USER_CERT_PATH=./certs/Admin@org1.example.com-cert.pem
FABRIC_USER_KEY_PATH=./certs/priv_sk
FABRIC_CA_CERT_PATH=./certs/ca.org1.example.com-cert.pem

# Certificate Authority (CA)
FABRIC_CA_HOST=localhost
FABRIC_CA_PORT=7054
FABRIC_CA_NAME=ca.org1.example.com
FABRIC_CA_ADMIN_ID=admin
FABRIC_CA_ADMIN_SECRET=adminpw

# Identity Configuration
BRICK_ADMIN_ATTR=brick-admin
BRICK_IDENTITY_HASH_ALGO=sha256

# Security Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Database Configuration (Future)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brick_iam
DB_USER=brick_user
DB_PASSWORD=change_me

# Private Data Collection (PDC) Configuration
PDC_ENABLED=true
PDC_COLLECTION_NAME=userProfilesPDC
PDC_REQUIREDPEERCOUNT=1
PDC_MAXPEERCOUNT=3

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
CORS_CREDENTIALS=true

# Email Configuration (Future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
BRICK_EMAIL_FROM=noreply@brick-iam.io

# Monitoring Configuration
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Feature Flags
FEATURE_ABAC_ENABLED=true
FEATURE_PDC_ENABLED=true
FEATURE_AUDIT_LOGGING_ENABLED=true
FEATURE_CERTIFICATE_VALIDATION_ENABLED=true
